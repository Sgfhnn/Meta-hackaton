# Copy to .env and fill in locally. Never commit .env.

# Model provider: any OpenAI-compatible endpoint serving Muse Spark Open
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Optional fallback providers, tried in order (comma-separated names of the
# provider blocks configured in auditor/model)
MODEL_FALLBACKS=

# GitHub token used only by the PR tool, scoped to the demo app's repo
GITHUB_TOKEN=
DEMO_REPO=

# Demo job board database
DATABASE_URL=postgresql://jobboard:jobboard@localhost:5432/jobboard
