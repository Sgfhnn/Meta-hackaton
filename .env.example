# Copy to .env and fill in locally. Never commit .env.

# Muse Spark Open on Baseten (OpenAI-compatible)
MODEL_BASE_URL=https://inference.baseten.co/v1
MODEL_NAME=meta-models/muse-spark-open-1026
BASETEN_API_KEY=
# Older name, still accepted by the backend if BASETEN_API_KEY is empty
MODEL_API_KEY=

# SAM 3.1: Hugging Face token for facebook/sam3.1 (Kaggle runs)
HF_TOKEN=

# Segmenter for the live backend: Roboflow serverless SAM 3
ROBOFLOW_API_KEY=

# Backend settings (defaults shown)
TRACE_DIR=traces
IMAGE_MAX_PX=768
SCAN_TIMEOUT_S=15
SAM_TIMEOUT_S=8
MUSE_ONLY_TOTALS=true
