# Copy to .env and fill in locally. Never commit .env.

# Muse Spark Open on Baseten (OpenAI-compatible)
MODEL_BASE_URL=https://inference.baseten.co/v1
MODEL_NAME=meta-models/muse-spark-open-1026
BASETEN_API_KEY=
# Older name, still accepted by the backend if BASETEN_API_KEY is empty
MODEL_API_KEY=

# SAM 3.1: Hugging Face token for facebook/sam3.1 (Kaggle runs, and the Modal service's secret)
HF_TOKEN=

# Which SAM counts the notes: roboflow (hosted SAM 3, default), modal (our SAM 3.1 endpoint) or off.
# SAM_OFF=1 also means off.
SAM_PROVIDER=roboflow
SAM_PROMPT=banknote
# Roboflow serverless SAM 3
ROBOFLOW_API_KEY=
# Modal SAM 3.1 (modal_sam/): the URL `modal deploy` prints, and a proxy-auth token pair
SAM_MODAL_URL=
SAM_MODAL_KEY=
SAM_MODAL_SECRET=
# A cold GPU container needs time to start; Roboflow keeps SAM_TIMEOUT_S
SAM_MODAL_TIMEOUT_S=25

# Optional fallback reader: Muse Spark 1.3 contributor via the Cline API.
# Off by default. MUSE_FALLBACK=cline sends the single-read retry (slow scans) to it.
MUSE_FALLBACK=none
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_MODEL=meta/muse-spark-1.3
CLINE_API_KEY=

# Backend settings (defaults shown)
TRACE_DIR=traces
IMAGE_MAX_PX=768
# Muse reads per scan; a total needs them to agree
MUSE_READS=2
# reasoning_effort sent to Muse; leave empty to omit it
MUSE_REASONING_EFFORT=low
# Hard limit for one scan; the two-read stage gets TWO_READ_TIMEOUT_S, then a single-read retry
SCAN_DEADLINE_S=60
TWO_READ_TIMEOUT_S=40
SAM_TIMEOUT_S=8
# Finished scan jobs are kept this long for GET /scan/{id}
JOB_TTL_S=600
MUSE_ONLY_TOTALS=false

# Folder outside the repo with clean_sheet.jpg and real_sheet.jpg (read B)
REFS_DIR=/data/refs
