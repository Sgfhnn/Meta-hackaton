# Copy to .env and fill in locally. Never commit .env.

# Muse Spark Open on Baseten (OpenAI-compatible)
MODEL_BASE_URL=https://inference.baseten.co/v1
MODEL_API_KEY=
MODEL_NAME=meta-models/muse-spark-open-1026

# SAM 3.1: Hugging Face token for facebook/sam3.1 (Kaggle runs)
HF_TOKEN=

# Fallback segmenter: Roboflow SAM 3 API (dev only)
ROBOFLOW_API_KEY=

# Backend: longest image side sent to the models (default 768)
IMAGE_MAX_PX=768
